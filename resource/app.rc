#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#pragma code_page(65001)

IDI_APP ICON "app.ico"
IDI_CLOSE ICON "close.ico"
1 RT_MANIFEST "app.manifest"

IDD_REGULAR_REPORT_CANCEL_AUDIT DIALOGEX 0, 0, 310, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "取消审核"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_CANCEL_AUDIT_REPORT, 9, 9, 292, 12
    LTEXT "原因类型", -1, 9, 28, 53, 12
    COMBOBOX IDC_CANCEL_AUDIT_TYPE, 64, 25, 237, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "取消原因", -1, 9, 49, 53, 12
    EDITTEXT IDC_CANCEL_AUDIT_REASON, 64, 47, 237, 52, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "当前账号密码", -1, 9, 108, 54, 12
    EDITTEXT IDC_CANCEL_AUDIT_PASSWORD, 64, 105, 237, 16, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "确认取消审核", IDOK, 128, 132, 92, 17
    PUSHBUTTON "返回", IDCANCEL, 228, 132, 73, 17
END

IDD_REGULAR_REPORT_ADD_ITEMS DIALOGEX 0, 0, 548, 251
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_ADD_ITEM_GROUP_LABEL, 8, 8, 122, 11
    LTEXT "", IDC_ADD_ITEM_OPTIONS_LABEL, 137, 8, 176, 11
    LTEXT "", IDC_ADD_ITEM_SELECTED_LABEL, 364, 8, 176, 11
    CONTROL "", IDC_ADD_ITEM_GROUPS, "SysListView32", WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 21, 122, 196, WS_EX_CLIENTEDGE
    CONTROL "", IDC_ADD_ITEM_OPTIONS, "SysListView32", WS_TABSTOP | LVS_REPORT | LVS_SHOWSELALWAYS, 137, 21, 176, 196, WS_EX_CLIENTEDGE
    PUSHBUTTON ">", IDC_ADD_ITEM_ONE, 320, 60, 37, 17
    PUSHBUTTON ">>", IDC_ADD_ITEM_ALL, 320, 82, 37, 17
    PUSHBUTTON "<", IDC_REMOVE_ITEM_ONE, 320, 110, 37, 17
    PUSHBUTTON "<<", IDC_REMOVE_ITEM_ALL, 320, 132, 37, 17
    CONTROL "", IDC_ADD_ITEM_SELECTED, "SysListView32", WS_TABSTOP | LVS_REPORT | LVS_SHOWSELALWAYS, 364, 21, 176, 196, WS_EX_CLIENTEDGE
    LTEXT "", IDC_ADD_ITEM_STATUS, 8, 223, 350, 19
    DEFPUSHBUTTON "", IDOK, 420, 227, 57, 17
    PUSHBUTTON "", IDCANCEL, 483, 227, 57, 17
END
