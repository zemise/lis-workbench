cmake_minimum_required(VERSION 3.20)

# Verify the actual CTest inventory before running the Windows release gate.
if(NOT DEFINED TEST_DIR OR NOT DEFINED TEST_CONFIG)
    message(FATAL_ERROR "TEST_DIR and TEST_CONFIG are required")
endif()
include("${TEST_DIR}/required_release_tests.cmake")
if(NOT LIS_REQUIRED_TESTS)
    message(FATAL_ERROR "Release test gate was not configured")
endif()
execute_process(
    COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${TEST_DIR}" -C "${TEST_CONFIG}" --show-only=json-v1
    RESULT_VARIABLE inventory_result OUTPUT_VARIABLE inventory ERROR_VARIABLE inventory_error)
if(NOT inventory_result EQUAL 0)
    message(FATAL_ERROR "Cannot read CTest inventory: ${inventory_error}")
endif()
string(JSON test_count LENGTH "${inventory}" tests)
set(actual_tests)
if(test_count GREATER 0)
    math(EXPR last_index "${test_count} - 1")
    foreach(index RANGE 0 ${last_index})
        string(JSON name GET "${inventory}" tests ${index} name)
        string(JSON command_type ERROR_VARIABLE command_error TYPE "${inventory}" tests ${index} command)
        if(command_error OR NOT command_type STREQUAL "ARRAY")
            message(FATAL_ERROR "Test executable/command unavailable: ${name}")
        endif()
        list(APPEND actual_tests "${name}")
    endforeach()
endif()
foreach(name IN LISTS LIS_REQUIRED_TESTS)
    if(NOT name IN_LIST actual_tests)
        message(FATAL_ERROR "Required release test is absent from CTest: ${name}")
    endif()
endforeach()
message(STATUS "Required release tests verified: ${LIS_REQUIRED_TESTS}")
